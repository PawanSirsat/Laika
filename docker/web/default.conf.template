# The Laika web app served on its own (LAI-1308), for a deployment whose proxy
# sends /api, /mcp and /webhooks to the server and everything else here.
#
# The nginx image renders this into /etc/nginx/conf.d/ at start. It substitutes
# only LAIKA_ names (NGINX_ENVSUBST_FILTER in the Dockerfile), so every other
# `$` below is nginx's own variable. server/test/tooling/web-serve.test.ts
# renders it the same way and checks the result against the server.

# The attachment store's origin with the space the CSP needs in front of it, or
# nothing when attachments are off, so the off policy is the server's
# attachments-off policy exactly, with no stray space.
map "${LAIKA_STORAGE_ORIGIN}" $laika_store_sources {
    ""      "";
    default " ${LAIKA_STORAGE_ORIGIN}";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    charset utf-8;
    # A redirect must not name this container's port to a browser behind the
    # proxy.
    absolute_redirect off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    include /etc/nginx/laika/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The server's paths, as isReservedPath in server/src/http/static.ts names
    # them. They reach this container only when the proxy routes them wrong, and
    # then they fail loudly instead of answering with the app's document.
    location ~ ^/(mcp|(api|webhooks)(/|$)) {
        return 404;
    }

    # Source maps are built for local debugging and never published (LAI-722).
    location ~* \.map$ {
        return 404;
    }

    # Hashed by the build, so a name never changes content. A missing one is a
    # 404, not the document: a stale chunk must fail, not cache HTML for a year.
    location /assets/ {
        include /etc/nginx/laika/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The document names the current bundle, so the browser asks every time.
    location = /index.html {
        include /etc/nginx/laika/security-headers.conf;
        add_header Cache-Control "no-cache";
    }

    # A real file, or the SPA's document for any route the app owns.
    location / {
        include /etc/nginx/laika/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
