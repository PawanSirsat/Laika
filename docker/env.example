# Copy to `.env` next to docker-compose.yml, then edit. Never commit the real file.
#
# This file is `env.example`, not `.env.example`, because the repo-root
# .gitignore ignores `.env*` — the dot-prefixed name would be untracked and
# nobody would ever see it.
#
# Required. Key material for encrypting the org's API keys and SMTP settings.
# Generate with:  openssl rand -base64 48
# Losing this value makes previously encrypted settings unreadable — keep it
# with your backups of the /data volume.
LAIKA_SECRET=replace-me-openssl-rand-base64-48

# Required. The URL your users type, including the scheme, no trailing slash.
# Invite links and webhook URLs are built from it, so a wrong value is silently
# wrong — people get invitations pointing somewhere they cannot reach, and
# GitHub delivers webhooks into nowhere. Behind a TLS proxy this is the proxy's
# address, not the container's.
LAIKA_PUBLIC_URL=https://laika.example.com

# Host port to publish. The container always listens on 3000 internally.
LAIKA_PORT=3000

# Optional: Microsoft SSO (LAI-1238). Set all three, or leave all three empty.
# Set, Microsoft is the ONLY way to sign in (no passwords), and a new person
# needs an invite to their exact work address. Requires LAIKA_PUBLIC_URL to be
# https:// — Microsoft refuses an http redirect address except on localhost.
# In Entra: App registrations -> New, single tenant, redirect URI (Web):
#   <LAIKA_PUBLIC_URL>/api/v1/auth/callback/microsoft
# Locked out? Empty these three and restart: passwords come back.
LAIKA_MICROSOFT_CLIENT_ID=
LAIKA_MICROSOFT_CLIENT_SECRET=
# Your directory's tenant ID (a GUID) or verified domain — never "common".
LAIKA_MICROSOFT_TENANT_ID=

# Optional: add every enabled Member of the Microsoft directory as a Laika
# member (no guests, no disabled accounts), read through Microsoft Graph every
# 15 minutes. Needs the three LAIKA_MICROSOFT_* lines above, and in Entra:
#   API permissions -> Microsoft Graph -> Application permissions -> User.Read.All
#   -> Grant admin consent.
# Additive only: nobody already in Laika is changed or deactivated.
LAIKA_MICROSOFT_DIRECTORY_SYNC=false
