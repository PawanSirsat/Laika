# Copy to `.env` next to docker-compose.yml, then edit. Never commit the real file.
#
# This file is `env.example`, not `.env.example`, because the repo-root
# .gitignore ignores `.env*` — the dot-prefixed name would be untracked and
# nobody would ever see it.
#
# Required. Key material for encrypting the org's API keys and SMTP settings.
# Generate with:  openssl rand -base64 48
# Losing this value makes previously encrypted settings unreadable — keep it
# with your backups of the /data volume.
LAIKA_SECRET=replace-me-openssl-rand-base64-48

# Host port to publish. The container always listens on 3000 internally.
LAIKA_PORT=3000
