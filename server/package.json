{
  "name": "@laika/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The single Node process that is Laika: API, MCP, SSE, cron, and the built SPA.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
