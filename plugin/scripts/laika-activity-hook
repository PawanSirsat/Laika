#!/bin/sh
#
# laika-activity-hook <prompt|session-start|session-end|turn-end> <agent-kind>
#
# Counts local activity for the Laika heatmap (LAI-752, D-079): one line per
# prompt and per session start, appended to ~/.laika/activity/events.log. The
# counts leave the machine only through `laika activity sync`, and only as
# per-day numbers. Installed into each agent's hook config by
# `laika activity on`; removed by `laika activity off`.
#
# ## What it must never do
#
# - **Keep, store or send any part of the prompt.** Every agent hands the
#   prompt text to this hook, on stdin (Kiro also in $USER_PROMPT). No
#   character of it is ever written anywhere: stdin is drained to /dev/null,
#   and $USER_PROMPT is unset before anything runs. **On an Omnigent turn
#   only** (D-090) — Claude Code's prompt on an Omnigent orchestrator's turn or
#   in an Omnigent primary — the first 4 KB are read into a variable to ask one
#   thing: does the prompt begin with Omnigent's `[System: ` marker? The
#   variable is cleared at once and the rest drained. Every other prompt never
#   lands in a variable. The only things written are a letter, the agent kind,
#   the time and, for an Omnigent orchestrator, its Omnigent session id.
# - **Print.** Claude Code adds UserPromptSubmit and SessionStart stdout to the
#   model's context, and exit 2 blocks the prompt in four agents. So stdout and
#   stderr go to /dev/null on the first line of real work, and every path ends
#   in `exit 0`. There is no `set -e`.
# - **Be slow.** The prompt path runs before every prompt. It forks nothing
#   when run by zsh (`laika activity on` installs it as `/bin/zsh -f <this>`
#   wherever zsh exists): zsh/datetime gives the time and zsh/system's sysread
#   drains stdin, both builtins — the marker check too. Under plain sh it costs
#   one `cat` and one `date` (and a `head` for the marker check). No network,
#   no git and no node on this path.
#
# ## The switch
#
# Every mode is a no-op unless ~/.laika/activity/state.json — one JSON line
# that `laika activity sync` rewrites from GET /api/v1/me/activity-sharing —
# says `"collect":true`. Read with the `read` builtin: no fork.
#
# ## Sessions nobody is typing in (LAI-757, D-080; LAI-775)
#
# A session started with `OMNIGENT=1` (Omnigent sets it in every process it
# launches; its primary session and its orchestrator's turns are the two
# exceptions below), a non-empty `CI`, or
# a non-empty `LAIKA_ACTIVITY_SKIP` is not the developer's, and counts
# nothing: stdin is drained and the hook exits before state.json is read — no
# event, no repo, no sync. Under zsh the check, like the drain before it, is
# builtins only.
#
# **The orchestrator's primary session is the person's** (D-088 item 9).
# Omnigent stamps `OMNIGENT=1` on its runner and so on every process under it
# — the session the person types to as much as the sub-agents it dispatches
# (Omnigent's runner/_entry.py). Two more of its variables tell them apart:
# `OMNIGENT_RUNNER_PRIMARY_SESSION_ID`, the session the runner was started
# for (host/connect.py), and `OMNIGENT_TERMINAL_LAUNCH_SESSION_ID`, the
# session that owned the terminal this agent was launched in
# (inner/terminal.py). Equal and non-empty, this is the primary: it counts as
# the person's in every respect — its prompts, its start, its tokens — and is
# never written to skip-sessions; at a counted start its id is kept, 0600 and
# never sent, in ~/.laika/activity/primary-sessions, so `laika activity status`
# can say how many there were. A sub-agent's two ids differ, and it is
# skipped as before. `CI` and `LAIKA_ACTIVITY_SKIP` skip whatever Omnigent says.
# One prompt of the primary's is not the person's: a notice Omnigent types
# into it itself when a sub-agent finishes, a timer fires or a terminal goes
# idle (runner/app.py posts it; the claude-native harness pastes it into the
# terminal). For Claude Code such a prompt begins `[System: ` and no `p` is
# written for it (D-090).
#
# **An Omnigent-native orchestrator's turns, when the person started them**
# (LAI-792, D-090).
# polly is not a terminal session: it thinks with Claude Code under the Claude
# Agent SDK — Omnigent's `claude-sdk` harness (inner/claude_sdk_executor.py) —
# and the SDK loads ~/.claude/settings.json, so this hook runs at every one of
# its turns, `prompt` as a turn starts and `turn-end` as it ends. It runs in
# the runner Omnigent launched for that session, which stamps
# `OMNIGENT_RUNNER_LAUNCH_HARNESS=claude-sdk` (runner/identity.py); the SDK
# sets `CLAUDE_CODE_ENTRYPOINT=sdk-py` (claude_agent_sdk's subprocess_cli.py;
# `claude -p` sets `sdk-cli` and is not it); and it is in no terminal, so
# `OMNIGENT_TERMINAL_LAUNCH_SESSION_ID` is unset.
# All three, for `claude-code`, under a runner primary id that is a plain id,
# is the orchestrator. A sub-agent it dispatches runs in a terminal of its own,
# or is another agent, and is skipped as before.
#
# Most of its turns nobody typed: Omnigent starts one itself whenever a
# sub-agent finishes, a timer fires or a terminal goes idle, and each such
# prompt begins `[System: `. So its `prompt` asks that one question of the
# prompt's start (above). A turn the person started appends
# `t omnigent <epoch> <session>` to events.log; one Omnigent started appends
# `w omnigent <epoch> <session>` — a letter rather than nothing, so that the
# `r omnigent <epoch> <session>` its end appends can be dropped, since `Stop`
# cannot tell the two apart. The session is the runner's primary id.
# `laika activity sync` drafts only the turns the person started, as the
# activity of their primary session; none is a typed prompt. At its start
# that id is kept in primary-sessions; nothing else is: no session-start
# payload is read, no session start or repo is recorded, nothing is skipped.
# Omnigent runs it with `--no-session-persistence`, so it writes no transcript
# and has no tokens to read. One thing this cannot tell: a child session the
# orchestrator itself defines on the `claude-sdk` harness looks the same, and
# counts the same.
#
# **One thing is kept for an automated session** (LAI-775, the owner's
# decision): its session id, so `laika activity sync` sends that session's
# tokens marked automated — the team's, never the developer's (D-091) — since
# its session files sit beside the developer's own. Only the session-start and session-end
# payloads are read for it, never a prompt's, and from them only a
# `"session_id"` that is a plain id (letters, digits, `.`, `_`, `-`, at most
# 128). It is appended to ~/.laika/activity/skip-sessions, 0600, and never
# sent. Nothing at all when activity is not on here (no ~/.laika/activity).
#
# ## A person's session start (LAI-770, D-084 item 5)
#
# For a counted session of an agent whose tokens `laika activity sync` reads —
# Claude Code, Codex, Gemini CLI — the session-start payload is read the same
# way, for its session id alone, and one line `<epoch> <session id> <branch>`
# is appended to ~/.laika/activity/sessions, 0600, never sent: the branch the
# session started on, for the token reader to find a task key in when the
# agent's own session files name no branch. The branch comes from the `git`
# call this path already made — one call, no new fork. Only a key in it ever
# leaves the machine, as a usage row's task. No prompt payload is read for it.
#
# ## A turn's end (LAI-776)
#
# Claude Code's `Stop` fires at the end of every turn (code.claude.com/docs/
# en/hooks), so a session that runs for hours would otherwise report its
# tokens only when it ends. On `turn-end` the hook is a trigger and nothing
# else: it drains stdin as the prompt path does — the payload carries the
# turn's last reply, `last_assistant_message`, and is never read — counts
# nothing but an Omnigent orchestrator's `r` (above), and launches the detached sync only while collection is on and
# `next_sync_at` has passed. Not due, it costs what a prompt costs: under zsh
# no fork. It never prints (Claude Code parses `Stop` output) and always
# exits 0 (exit 2 there keeps Claude from stopping).
#
# Owned by SHELL (plugin/). LAI-752, LAI-757, LAI-787, LAI-792.

exec >/dev/null 2>&1
unset USER_PROMPT
umask 077

MODE="${1:-}"
AGENT="${2:-}"
case "$AGENT" in '' | *[!a-z0-9-]*) AGENT=other ;; esac

# Whose session this is, decided once, by builtins alone (D-088 item 9,
# LAI-792; see the header): automated, the orchestrator's primary, an
# Omnigent-native orchestrator's turns, or simply the person's.
AUTOMATED=no
PRIMARY=no
ORCHESTRATOR=no
OSID=''
if [ -n "${CI:-}" ] || [ -n "${LAIKA_ACTIVITY_SKIP:-}" ]; then
  AUTOMATED=yes
elif [ "${OMNIGENT:-}" = 1 ]; then
  AUTOMATED=yes
  if [ -n "${OMNIGENT_RUNNER_PRIMARY_SESSION_ID:-}" ]; then
    if [ "${OMNIGENT_TERMINAL_LAUNCH_SESSION_ID:-}" = "$OMNIGENT_RUNNER_PRIMARY_SESSION_ID" ]; then
      PRIMARY=yes
      AUTOMATED=no
    elif [ "$AGENT" = claude-code ] && [ -z "${OMNIGENT_TERMINAL_LAUNCH_SESSION_ID:-}" ] &&
      [ "${OMNIGENT_RUNNER_LAUNCH_HARNESS:-}" = claude-sdk ]; then
      # Its lane is the runner's primary id, written to events.log: a plain
      # id (as a payload's session id must be), or it counts nothing.
      LC_ALL=C
      OSID="$OMNIGENT_RUNNER_PRIMARY_SESSION_ID"
      [ "${CLAUDE_CODE_ENTRYPOINT:-}" = sdk-py ] && ORCHESTRATOR=yes
      case "$OSID" in *[!A-Za-z0-9._-]*) ORCHESTRATOR=no ;; esac
      [ "${#OSID}" -gt 128 ] && ORCHESTRATOR=no
      [ "$ORCHESTRATOR" = yes ] && AUTOMATED=no
    fi
  fi
fi

# A session's start or end payload is the only one ever read, and only for
# its id: neither carries a prompt. An automated session's (LAI-775); a
# person's start, for an agent whose tokens are read (LAI-770) — never the
# orchestrator's, whose id comes from Omnigent. The prompt path pays one test
# for it, which is all its budget allows.
KEEP=no
PAYLOAD=''
if [ "$MODE" != prompt ]; then
  if [ "$AUTOMATED" = yes ]; then
    case "$MODE" in session-start | session-end) KEEP=yes ;; esac
  elif [ "$MODE" = session-start ] && [ "$ORCHESTRATOR" = no ]; then
    case "$AGENT" in claude-code | codex | gemini-cli) KEEP=yes ;; esac
  fi
fi

# The one prompt whose start is looked at (D-090): Claude Code's, on an
# Omnigent orchestrator's turn or in an Omnigent primary. Every other prompt
# goes straight to /dev/null, unread.
PEEK=no
if [ "$MODE" = prompt ] && [ "$AGENT" = claude-code ]; then
  if [ "$ORCHESTRATOR" = yes ] || [ "$PRIMARY" = yes ]; then
    PEEK=yes
    LC_ALL=C
  fi
fi
LOOK=''
CHUNK=''

# --- drain stdin, and the time ------------------------------------------------
# First, whatever happens next: an agent writing the prompt to a hook that
# exited unread would get EPIPE. A terminal on stdin means somebody ran this
# by hand: there is nothing to drain, and reading would wait for them.
NOW=''
BUILTINS=no
if [ -n "${ZSH_VERSION:-}" ] && zmodload zsh/datetime zsh/system; then
  BUILTINS=yes
  # -o 1 writes what was read to fd 1, which is /dev/null: nothing is stored.
  if [ "$KEEP" = yes ]; then
    [ -t 0 ] || { sysread -s 65536 PAYLOAD; while sysread -o 1 -s 65536; do :; done; }
  elif [ "$PEEK" = yes ]; then
    # The first 4 KB at most; the rest is drained below, once it is decided.
    [ -t 0 ] || while [ "${#LOOK}" -lt 4096 ] && sysread -s 4096 CHUNK; do
      LOOK="$LOOK$CHUNK"
    done
  else
    [ -t 0 ] || while sysread -o 1 -s 65536; do :; done
  fi
  NOW="$EPOCHSECONDS"
else
  if [ "$KEEP" = yes ]; then
    [ -t 0 ] || { PAYLOAD="$(head -c 65536)"; cat >/dev/null; }
  elif [ "$PEEK" = yes ]; then
    [ -t 0 ] || LOOK="$(head -c 4096)"
  else
    [ -t 0 ] || cat >/dev/null
  fi
  NOW="${EPOCHSECONDS:-}"
fi

# --- one question of the prompt's start (D-090) -------------------------------------
# Does the "prompt" value begin with Omnigent's `[System: ` marker? A string
# straight after the key — only `:` and spaces between — whatever comes after
# the marker. Then everything read is cleared and the rest drained: only the
# answer, RUNTIME, goes any further.
RUNTIME=no
if [ "$PEEK" = yes ]; then
  REST="$LOOK"
  while :; do
    case "$REST" in *'"prompt"'*) ;; *) break ;; esac
    REST="${REST#*\"prompt\"}"
    GAP="${REST%%\"*}"
    case "$GAP" in *:*) ;; *) continue ;; esac
    case "$GAP" in *[!:\ ]*) continue ;; esac
    case "${REST#*\"}" in '[System: '*) RUNTIME=yes ;; esac
    break
  done
  LOOK=''
  CHUNK=''
  REST=''
  GAP=''
  if [ "$BUILTINS" = yes ]; then
    [ -t 0 ] || while sysread -o 1 -s 65536; do :; done
  else
    [ -t 0 ] || cat >/dev/null
  fi
fi

# --- the payload's session id: a plain id, or nothing ------------------------------
SID=''
if [ "$KEEP" = yes ]; then
  LC_ALL=C
  REST="${PAYLOAD#*\"session_id\"}"
  if [ "$REST" != "$PAYLOAD" ]; then
    GAP="${REST%%\"*}"
    VALUE="${REST#*\"}"
    SID="${VALUE%%\"*}"
    # A string value straight after the key — only `:` and spaces between —
    # and closed by its quote; a plain id, nothing that could be anything else.
    case "$GAP" in *[!:\ ]*) SID='' ;; esac
    [ "$SID" = "$VALUE" ] && SID=''
    case "$SID" in '' | *[!A-Za-z0-9._-]*) SID='' ;; esac
    [ "${#SID}" -gt 128 ] && SID=''
  fi
  PAYLOAD=''
fi

# --- an automated session: nothing counted, its id kept -------------------------
if [ "$AUTOMATED" = yes ]; then
  if [ "$KEEP" = yes ] && [ -d "$HOME/.laika/activity" ]; then
    if [ -n "$SID" ]; then
      case "$NOW" in '' | *[!0-9]*) NOW="$(date +%s)" ;; esac
      # One printf, one O_APPEND write; umask 077 makes the file 0600.
      printf '%s %s\n' "$NOW" "$SID" >>"$HOME/.laika/activity/skip-sessions"
    fi
  fi
  exit 0
fi

case "$NOW" in '' | *[!0-9]*) NOW="$(date +%s)" ;; esac

DIR="$HOME/.laika/activity"
STATE=''
IFS= read -r STATE <"$DIR/state.json"

# Devin CLI reads ~/.claude/settings.json hooks by default and sets
# DEVIN_PROJECT_DIR (docs.devin.ai/cli/extensibility/hooks/overview). Its
# prompts are not Claude Code's, and no hook was installed for Devin, so they
# are not counted at all rather than counted under the wrong agent.
if [ "$AGENT" = claude-code ] && [ -n "${DEVIN_PROJECT_DIR:-}" ]; then
  exit 0
fi

COLLECT=no
case "$STATE" in *'"collect":true'*) COLLECT=yes ;; esac

# --- an Omnigent-native orchestrator's turn (LAI-792) -----------------------------
# Its start and end, never as a typed prompt; at its start, its id as a primary.
# One printf, one O_APPEND write each, as below.
if [ "$ORCHESTRATOR" = yes ]; then
  if [ "$COLLECT" = yes ]; then
    case "$MODE" in
      prompt)
        if [ "$RUNTIME" = yes ]; then
          printf 'w omnigent %s %s\n' "$NOW" "$OSID" >>"$DIR/events.log"
        else
          printf 't omnigent %s %s\n' "$NOW" "$OSID" >>"$DIR/events.log"
        fi
        ;;
      turn-end) printf 'r omnigent %s %s\n' "$NOW" "$OSID" >>"$DIR/events.log" ;;
      session-start) printf '%s %s\n' "$NOW" "$OSID" >>"$DIR/primary-sessions" ;;
    esac
  fi
  [ "$MODE" = prompt ] && exit 0
fi

if [ "$MODE" = prompt ]; then
  # A notice Omnigent typed into its Claude Code primary is no prompt of the
  # person's (D-090): nothing is written for it.
  [ "$RUNTIME" = yes ] && exit 0
  # One printf, one O_APPEND write: two hooks at once cannot interleave a line.
  [ "$COLLECT" = yes ] && printf 'p %s %s\n' "$AGENT" "$NOW" >>"$DIR/events.log"
  exit 0
fi

# --- session start / end -------------------------------------------------------
if [ "$MODE" = session-start ] && [ "$COLLECT" = yes ] && [ "$ORCHESTRATOR" = no ]; then
  printf 's %s %s\n' "$AGENT" "$NOW" >>"$DIR/events.log"

  # Which repository this session is in, and the branch it is on. Kept on
  # this machine only: the repo decides which repos `laika activity sync`
  # counts commits in, the branch which task key its tokens may carry
  # (LAI-770). One `git` call for both; a repo with no commit has no branch.
  NL='
'
  OUT="$(git -C "${CLAUDE_PROJECT_DIR:-$PWD}" rev-parse --show-toplevel --abbrev-ref HEAD 2>/dev/null)"
  TOP="${OUT%%"$NL"*}"
  BRANCH="${OUT#*"$NL"}"
  [ "$BRANCH" = "$OUT" ] && BRANCH=''
  case "$BRANCH" in HEAD | *[!A-Za-z0-9._/-]*) BRANCH='' ;; esac
  [ "${#BRANCH}" -gt 255 ] && BRANCH=''
  if [ -n "$SID" ]; then
    # One printf, one O_APPEND write; umask 077 makes the file 0600.
    if [ -n "$BRANCH" ]; then
      printf '%s %s %s\n' "$NOW" "$SID" "$BRANCH" >>"$DIR/sessions"
    else
      printf '%s %s\n' "$NOW" "$SID" >>"$DIR/sessions"
    fi
    # The orchestrator's primary, counted as the person's (D-088 item 9).
    [ "$PRIMARY" = yes ] && printf '%s %s\n' "$NOW" "$SID" >>"$DIR/primary-sessions"
  fi
  REPOS="$DIR/repos"
  case "$TOP" in
    '' | *'	'* | *"$NL"*) ;;
    *)
      # Deduped by path, and entries unused for 30 days dropped. Written to a
      # temp file and renamed, so a reader never sees half a file. The path
      # goes to awk through the environment: `-v` would expand backslashes.
      [ -f "$REPOS" ] || : >"$REPOS"
      LAIKA_TOP="$TOP" awk -v now="$NOW" -v cutoff="$((NOW - 2592000))" \
        'BEGIN { FS = OFS = "\t"; top = ENVIRON["LAIKA_TOP"] }
         $2 != top && $1 >= cutoff { print }
         END { print now, top }' \
        "$REPOS" >"$REPOS.$$" && mv -f "$REPOS.$$" "$REPOS"
      rm -f "$REPOS.$$"
      ;;
  esac
fi

# A turn's end launches only while collection is on: the once-a-day recheck
# while off is the session events', and a turn is far more frequent.
DUE=no
case "$MODE" in
  session-start | session-end) DUE=yes ;;
  turn-end) [ "$COLLECT" = yes ] && DUE=yes ;;
esac

if [ "$DUE" = yes ]; then
  # Due when state.json's next_sync_at has passed: the sync writes it as the
  # later of its last run plus min_sync_interval_s and any Retry-After. While
  # collection is off it is the once-a-day recheck, and nothing else runs.
  NEXT="${STATE#*\"next_sync_at\":}"
  [ "$NEXT" = "$STATE" ] && NEXT=0
  NEXT="${NEXT%%[!0-9]*}"
  if [ -n "$STATE" ] && [ "$NOW" -ge "${NEXT:-0}" ]; then
    # Fully detached, and it never holds this hook's stdout open: the agent
    # sees this hook end at once (Claude Code gives SessionEnd 1.5 s in all).
    # `--background` makes the CLI re-spawn itself in a new session (setsid),
    # so neither a timeout kill nor a Ctrl-C to the agent reaches it.
    SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
    CLI="$SELF_DIR/../../cli/bin/laika"
    if [ -x "$CLI" ]; then
      (nohup "$CLI" activity sync --background </dev/null >/dev/null 2>&1 &)
    fi
  fi
fi

exit 0
