#!/bin/sh
# laika-claude — start Claude Code connected to your Laika board, with presence.
#
# Use it exactly like `claude`; every flag passes straight through:
#   laika-claude
#   laika-claude --dangerously-skip-permissions
#
# It runs in whatever directory you are standing in, so projects, history and
# resumed sessions behave exactly as they do with plain `claude`. The only
# difference is the Laika plugin: the MCP tools, the /laika:* commands, and the
# heartbeats that make your session visible on the board's Capacity screen.
#
# Settings come from ~/.laika/env, written by install.sh. Each person has their
# own token there — a token is personal, and the board attributes every action
# and every session to whoever owns it.
#
# Once `laika tool add claude-code` has installed Claude Code's own credential
# (~/.laika/agents/claude-code.json), that is used instead, so the board sees
# this tool as itself (LAI-1060, plan LAI-1042 §L2). Only a file `tool add`
# wrote counts — it says `"source": "tool-add"` — so a credential saved by
# `laika agent login` before this existed changes nothing for anyone.
set -eu

# ---------------------------------------------------------------------------
# Where this script really lives.
#
# **Resolved once, before anything uses it** (LAI-482). Installed on PATH this
# script IS a symlink (~/.local/bin/laika-claude), so `dirname "$0"` names the
# symlink's directory rather than the checkout — which produced a --plugin-dir
# of ~/.local, a path that does not exist, handed to claude with exit 0 and no
# complaint (LAI-616), and an installer hint pointing at ~/.local/bin/install.sh,
# where there is no installer. Two uses, one defect, because each derived the
# path for itself. There is one derivation now and everything reads from it.
#
# BSD readlink has no -f, so the loop is the portable way.
# ---------------------------------------------------------------------------
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

CONFIG="${LAIKA_CONFIG:-$HOME/.laika/env}"

if [ -r "$CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG"
fi

AGENT_CREDENTIAL="$HOME/.laika/agents/claude-code.json"
if [ -r "$AGENT_CREDENTIAL" ] && grep -q '"source": "tool-add"' "$AGENT_CREDENTIAL"; then
  # Read, never sourced: the file is JSON that `laika tool add` writes, one key a line.
  AGENT_URL="$(sed -n 's/^ *"url": *"\([^"]*\)".*/\1/p' "$AGENT_CREDENTIAL")"
  AGENT_TOKEN="$(sed -n 's/^ *"token": *"\([^"]*\)".*/\1/p' "$AGENT_CREDENTIAL")"
  if [ -n "$AGENT_URL" ] && [ -n "$AGENT_TOKEN" ]; then
    LAIKA_URL="$AGENT_URL"
    LAIKA_TOKEN="$AGENT_TOKEN"
  fi
  unset AGENT_URL AGENT_TOKEN
fi

if [ -z "${LAIKA_URL:-}" ] || [ -z "${LAIKA_TOKEN:-}" ]; then
  echo "laika-claude: not configured yet." >&2
  # Only offer the installer if it is actually there. Naming a path with
  # nothing at it is what LAI-482 was about, and a half-copied checkout would
  # reproduce it by a different route.
  if [ -x "$SCRIPT_DIR/install.sh" ]; then
    echo "  Run the installer:  $SCRIPT_DIR/install.sh" >&2
  else
    echo "  Expected an installer at $SCRIPT_DIR/install.sh and found none —" >&2
    echo "  the checkout looks incomplete. Re-clone, or set the two values below." >&2
  fi
  echo "  Or set LAIKA_URL and LAIKA_TOKEN in $CONFIG" >&2
  echo "  Or pair this machine and add Claude Code from the browser:" >&2
  echo "  laika device pair, then laika tool add claude-code" >&2
  exit 1
fi

export LAIKA_URL LAIKA_TOKEN

if [ ! -f "$PLUGIN_DIR/.claude-plugin/plugin.json" ]; then
  echo "laika-claude: no plugin at $PLUGIN_DIR — is the checkout still there?" >&2
  exit 1
fi

exec claude --plugin-dir "$PLUGIN_DIR" "$@"
