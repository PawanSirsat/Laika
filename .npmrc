# Refuse to install under a Node that does not match package.json "engines".
# Laika targets Node 22 LTS (SPEC §10.1); a silent install on 18 produces
# failures much further downstream.
engine-strict=true

# Workspace packages resolve to each other, never to a registry copy.
link-workspace-packages=true
prefer-workspace-packages=true

# Keep node_modules strict — a package may only import what it declares.
# This is what stops "it worked because eslint happened to hoist it".
node-linker=isolated
